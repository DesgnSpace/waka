# PostgreSQL connection used by the API and startup migrations.
DATABASE_URL=postgresql://waka:change-me@postgres:5432/waka
# Compose-only local database password. Not read by the Bun application.
POSTGRES_PASSWORD=change-me

# PostgreSQL TLS mode. Use false for a local/private network database.
DATABASE_SSL=false

# JWT signing secret. Replace with a long random value.
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Initial dashboard user. Both values are optional, but set both to create the user.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# AWS SES region and IAM access key credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key

# Server settings.
NODE_ENV=development
PORT=3000

# Optional: allow browser requests from these comma-separated origins.
CORS_ORIGIN=
# Optional: canonical host or origin used for CORS when CORS_ORIGIN is empty.
DOMAIN=
# Set to true only when every request passes through one trusted reverse proxy
# that overwrites X-Forwarded-For. Per-IP limits then key on the client address;
# leave unset to key on the connection address.
TRUST_PROXY=

# Optional: SES configuration set name. The default is waka-events.
SES_CONFIGURATION_SET=waka-events
# Optional: reject SES/SNS webhook messages from other topic ARNs.
SES_SNS_TOPIC_ARN=
# Optional: Sentry error reporting. Leave empty to disable it.
SENTRY_DSN=
